# ── App Mode ──────────────────────────────────────────────────────────────────
# Options: demo | sandbox | production
APP_MODE=demo
ENVIRONMENT=development

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (dev/demo):
DATABASE_URL=sqlite:///./agentsetu.db
# PostgreSQL (staging/production):
# DATABASE_URL=postgresql://user:password@host:5432/agentsetu

# ── Redis (optional — for rate limiting) ─────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0

# ── Razorpay ─────────────────────────────────────────────────────────────────
# Test mode: rzp_test_XXXXXXXXXXXXXXXX
# Live mode: rzp_live_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXX

# Razorpay OAuth (technology partner / connected accounts)
RAZORPAY_OAUTH_CLIENT_ID=
RAZORPAY_OAUTH_CLIENT_SECRET=

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXX
OPENAI_MODEL=gpt-4o-mini

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Base URL ──────────────────────────────────────────────────────────────────
# Used for Razorpay callback/webhook URLs
BASE_URL=http://localhost:8000

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=
# Log format: "text" for dev, "json" for production log aggregators
LOG_FORMAT=text

# ── Webhook Base URL (Phase 8) ───────────────────────────────────────────────
# Public-facing URL that Razorpay sends webhooks to (if different from BASE_URL)
RAZORPAY_WEBHOOK_BASE_URL=

# ── Scoring weights (must sum to 1.0) ─────────────────────────────────────────
SCORE_WEIGHT_PRICE=0.45
SCORE_WEIGHT_DELIVERY=0.25
SCORE_WEIGHT_RATING=0.20
SCORE_WEIGHT_POLICY=0.10

# ── WhatsApp (future) ─────────────────────────────────────────────────────────
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
